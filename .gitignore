# Local environment files
.env
.venv/
.claude/
.vscode/

# Python caches
**/__pycache__/
*.pyc

# Frontend generated artifacts
frontend/node_modules/
frontend/dist/

# Runtime-generated data
asm-rules/
backend/asm-rules/
backend/nuclei-templates/
mcp-server/knowledge_store.json
backend/scripts/stability_reports/
backend/scripts/monitor_reports/

# Temp files
.DS_Store

backend/burp/burpsuite_pro.jar
backend/burp/*.jar
backend/burp/*.json
backend/burp-export/
burp/

# BAS internal PKI root CA/server private keys -- must live only in the
# bas_ca_data named docker volume, never in the repo. This also guards
# against a stray local run of bas_ca.py before that volume is wired up.
backend/bas_ca/

# bas-agent build output -- regenerable via bas-agent/build.sh. The actually
# SERVED linux/windows binaries live at backend/bas_agent_dist/ (committed
# on purpose, no CI build step exists yet); this dist/ dir also holds a
# darwin-arm64 build that's dev/smoke-test-only, never a customer download.
bas-agent/dist/
backend/celerybeat-schedule

# Scan output artifacts (do not commit raw target dumps)
backend/ar*.txt
backend/*.tmp

# fastembed model cache (baixado em runtime; embutido na imagem via Dockerfile)
backend/.fastembed_cache/
